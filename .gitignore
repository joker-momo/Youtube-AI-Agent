# Agent tooling dirs are ignored wholesale EXCEPT the protocol/knowledge/skill
# files that CLAUDE.md/AGENTS.md tell every agent to read — those are tracked so
# a fresh clone (e.g. the Ubuntu box) carries the operating rules, project-local
# skills, file map + learnings. Volatile logs (memory.md, buglog.json,
# token-ledger.json) and machine-local settings stay ignored. Marketplace
# PLUGINS (superpowers, caveman, agent-skills, …) live outside the repo in
# ~/.claude/plugins and must be reinstalled per machine — see PORTING.md.
/.claude/*
!/.claude/rules/
!/.claude/skills/
/.codegraph
/.cursor
/.wolf/*
!/.wolf/OPENWOLF.md
!/.wolf/anatomy.md
!/.wolf/cerebrum.md
/docs/superpowers
/.cache
/.remotion
/logs
/.venv
/tools/melo-venv
/.understand-anything
/inputs/ideas
/scratch
jobs.db
job_queue.db
worker_logs.txt
remotion/src/*.js


# Native runtime pidfiles (installers/run.sh)
.run/
/.agent/*
!/.agent/AGENTS.md
!/.agent/INSTALL.md
!/.agent/skills/
!/.agent/workflows/
!/.agent/agents/
.worktrees/
/docs/plans
queue.db
/.serena

# Personal Claude Code overrides
.claude/settings.local.json

# Generated continuity render-proof fixture (deterministic, rebuilt on demand)
remotion/public/test_fixtures/
# Added by code-review-graph
.code-review-graph/
/.gemini
/.qoder

# Runtime junk
logs_run_sh.out
.trinity/
/.agents
/.codex
/configs

# Long-form Elena presenter clips (binary, provided per-channel, not tracked)
configs/*/assets/elena/
remotion/public/assets/elena/
remotion/public/test_fixtures/
/tools
.render_tmp/
