    "pt-BR": {"family": "Manrope", "subsets": ["latin", "latin-ext"]},
    "ko-KR": {"family": "Noto Sans KR", "subsets": ["korean"]},
    "ja-JP": {"family": "Noto Sans JP", "subsets": ["japanese"]}
  }
}
