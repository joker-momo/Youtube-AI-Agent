{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localized-channel-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "rolloutOrder", "channelId", "locale", "brand", "voice", "render", "content", "canary"],
  "properties": {
    "schemaVersion": {"const": "localized-channel-v2/v1"},
    "enabled": {"type": "boolean"},
    "qualification": {"type": "boolean"},
    "rolloutOrder": {"type": "integer", "minimum": 1, "maximum": 5},
    "channelId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "locale": {"enum": ["en-US", "fr-FR", "pt-BR", "ko-KR", "ja-JP"]},
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "introClip", "disclaimerClip", "outroClip"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "introClip": {"type": "string", "minLength": 1},
        "disclaimerClip": {"type": "string", "minLength": 1},
        "outroClip": {"type": "string", "minLength": 1}
      }
    },
    "voice": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "language", "voiceId", "speed"],
      "properties": {
        "provider": {"enum": ["kokoro", "melo"]},
        "language": {"type": "string", "minLength": 1},
        "voiceId": {"type": "string", "minLength": 1},
        "speed": {"type": "number", "exclusiveMinimum": 0.5, "maximum": 1.5}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "concurrency", "subtitles"],
      "properties": {
        "composition": {"const": "LocalizedV2ChannelVideo"},
        "concurrency": {"const": "auto"},
        "subtitles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"const": false}}
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetDurationSec"],
      "properties": {
        "type": {"const": "long_form"},
        "targetDurationSec": {"type": "integer", "minimum": 300, "maximum": 1800}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "evidence"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audio", "font", "render", "humanReview", "dashboardLifecycle"],
          "properties": {
            "audio": {"enum": ["PENDING", "PASS"]},
            "font": {"enum": ["PENDING", "PASS"]},
            "render": {"enum": ["PENDING", "PASS"]},
            "humanReview": {"enum": ["PENDING", "PASS"]},
            "dashboardLifecycle": {"enum": ["PENDING", "PASS"]}
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {
        "properties": {
          "voice": {"type": "object"},
          "canary": {
            "properties": {
              "status": {"const": "APPROVED"},
              "checks": {
                "properties": {
                  "audio": {"const": "PASS"},
                  "font": {"const": "PASS"},
                  "render": {"const": "PASS"},
                  "humanReview": {"const": "PASS"},
                  "dashboardLifecycle": {"const": "PASS"}
                }
              },
              "evidence": {"minItems": 5}
            }
          }
        }
      },
      "else": {
        "if": {
          "required": ["qualification"],
          "properties": {"qualification": {"const": true}}
        },
        "then": {
          "properties": {
            "enabled": {"const": false},
            "voice": {"type": "object"},
            "canary": {
              "properties": {
                "status": {"const": "PENDING"}
              }
            }
          }
        },
        "else": {
          "properties": {
            "voice": {"type": "null"},
            "canary": {
              "properties": {
                "status": {"const": "PENDING"},
                "checks": {
                  "properties": {
                    "audio": {"const": "PENDING"},
                    "font": {"const": "PENDING"},
                    "render": {"const": "PENDING"},
                    "humanReview": {"const": "PENDING"},
                    "dashboardLifecycle": {"const": "PENDING"}
                  }
                },
                "evidence": {"maxItems": 0}
              }
            }
          }
        }
      }
    }
  ]
}
