{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "locale", "assets"],
  "properties": {
    "schemaVersion": {"const": "localized-assets-v2/v1"},
    "locale": {"enum": ["en-US", "fr-FR", "pt-BR", "ko-KR", "ja-JP"]},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sceneId", "type", "path", "source"],
        "properties": {
          "sceneId": {"type": "string", "minLength": 1},
          "type": {"enum": ["video", "graphic"]},
          "path": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
