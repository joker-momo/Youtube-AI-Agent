{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "locale", "totalDurationSec", "scenes"],
  "properties": {
    "schemaVersion": {"const": "localized-audio-timing-v2/v1"},
    "locale": {"enum": ["en-US", "fr-FR", "pt-BR", "ko-KR", "ja-JP"]},
    "totalDurationSec": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "startSec", "durationSec"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "startSec": {"type": "number", "minimum": 0},
          "durationSec": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
