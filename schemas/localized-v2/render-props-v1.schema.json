{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "publicPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": {"pattern": "(^|/)\\.\\.(/|$)"}
    }
  },
  "required": ["schemaVersion", "locale", "composition", "channel", "style", "render", "scenes", "audio", "seo", "branding"],
  "properties": {
    "schemaVersion": {"const": "localized-render-props-v2/v1"},
    "locale": {"enum": ["en-US", "fr-FR", "pt-BR", "ko-KR", "ja-JP"]},
    "composition": {"const": "LocalizedV2ChannelVideo"},
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["palette"],
      "properties": {
        "palette": {
          "type": "object", "additionalProperties": false,
          "required": ["background", "primary", "secondary", "accent", "text"],
          "properties": {
            "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "primary": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "secondary": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "text": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
          }
        }
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["fps", "resolution", "duration_sec", "duration_in_frames", "subtitles"],
      "properties": {
        "fps": {"type": "integer", "minimum": 24, "maximum": 60},
        "resolution": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"},
        "duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "duration_in_frames": {"type": "integer", "minimum": 1},
        "subtitles": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled"], "properties": {"enabled": {"const": false}}
        }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "duration_sec", "narration", "visual_type", "visual_prompt", "on_screen_text", "caption", "motion", "asset_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "duration_sec": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string", "minLength": 1},
          "visual_type": {"enum": ["video", "graphic"]},
          "visual_prompt": {"type": "string", "minLength": 1},
          "on_screen_text": {"type": "string"},
          "caption": {"const": ""},
          "motion": {"type": "string", "minLength": 1},
          "asset_refs": {
            "type": "object", "additionalProperties": false,
            "required": ["background", "background_media_kind"],
            "properties": {
              "background": {"$ref": "#/$defs/publicPath"},
              "background_media_kind": {"const": "video"}
            }
          },
          "graphic": {
            "type": "object", "additionalProperties": false,
            "required": ["needed", "prompt", "image_ref"],
            "properties": {
              "needed": {"const": true},
              "prompt": {"type": "string", "minLength": 1},
              "image_ref": {"$ref": "#/$defs/publicPath"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"visual_type": {"const": "graphic"}}},
            "then": {"required": ["graphic"]},
            "else": {"not": {"required": ["graphic"]}}
          }
        ]
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["narration", "music"],
      "properties": {
        "narration": {"$ref": "#/$defs/publicPath"},
        "music": {"const": null}
      }
    },
    "seo": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "thumbnail_path", "thumbnail_text"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "thumbnail_path": {"$ref": "#/$defs/publicPath"},
        "thumbnail_text": {"type": "string", "minLength": 1}
      }
    },
    "branding": {
      "type": "object", "additionalProperties": false,
      "required": ["intro_video_path", "disclaimer_video_path", "outro_video_path", "intro_sec", "disclaimer_sec", "outro_sec", "watermark_enabled", "show_channel_name_overlay", "hybrid_card_bg"],
      "properties": {
        "intro_video_path": {"$ref": "#/$defs/publicPath"},
        "disclaimer_video_path": {"$ref": "#/$defs/publicPath"},
        "outro_video_path": {"$ref": "#/$defs/publicPath"},
        "intro_sec": {"type": "number", "exclusiveMinimum": 0},
        "disclaimer_sec": {"type": "number", "exclusiveMinimum": 0},
        "outro_sec": {"type": "number", "exclusiveMinimum": 0},
        "watermark_enabled": {"const": false},
        "show_channel_name_overlay": {"const": false},
        "hybrid_card_bg": {"$ref": "#/$defs/publicPath"}
      }
    }
  }
}
