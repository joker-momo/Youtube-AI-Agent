{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "locale", "scenes"],
  "properties": {
    "schemaVersion": {"const": "localized-scenes-v2/v1"},
    "locale": {"enum": ["en-US", "fr-FR", "pt-BR", "ko-KR", "ja-JP"]},
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "narration", "visualType", "visualPrompt", "searchBrief"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "narration": {"type": "string", "minLength": 1, "maxLength": 3000},
          "visualType": {"enum": ["video", "graphic"]},
          "visualPrompt": {"type": "string", "minLength": 1, "maxLength": 1000},
          "searchBrief": {
            "type": "object", "additionalProperties": false,
            "required": ["language", "queries"],
            "properties": {
              "language": {"const": "en"},
              "queries": {
                "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'’&()/+:-]*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
